<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    ENROLLMENT VIEWS
    ================================================================== -->

    <!-- Enrollment List View -->
    <record id="view_school_enrollment_list" model="ir.ui.view">
        <field name="name">school.enrollment.list</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list string="Enrollments" multi_edit="1" sample="1"
                decoration-info="state == 'pending'"
                decoration-success="state == 'confirmed'"
                decoration-muted="state in ('completed', 'cancelled', 'dropped')">
                <field name="student_id" />
                <field name="course_id" />
                <field name="enrollment_date" />
                <field name="completion_date" optional="hide" />
                <field name="teacher_id" readonly="1" />
                <field name="priority" optional="hide" />
                <field name="state" widget="badge" decoration-info="state == 'pending'"
                    decoration-success="state == 'confirmed'" decoration-muted="state in ('completed', 'cancelled', 'dropped')" />
            </list>
        </field>
    </record>

    <!-- Enrollment Form View -->
    <record id="view_school_enrollment_form" model="ir.ui.view">
        <field name="name">school.enrollment.form</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <form string="Enrollment">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                        invisible="state != 'pending'" class="btn-primary" />
                    <button name="action_approve" type="object" string="Approve"
                        invisible="state != 'submitted'" class="btn-success" />
                    <button name="action_complete" type="object" string="Mark Complete"
                        invisible="state != 'confirmed'" class="btn-info" />
                    <button name="action_drop" type="object" string="Drop Course"
                        invisible="state not in ('pending', 'submitted', 'confirmed')" />
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state in ('completed', 'cancelled', 'dropped')" class="btn-danger" />
                    <field name="state" widget="statusbar" statusbar_visible="pending,submitted,confirmed,completed" readonly="1" />
                </header>

                <sheet>
                    <group>
                        <group string="Enrollment Details">
                            <field name="student_id" />
                            <field name="course_id" />
                            <field name="enrollment_date" />
                            <field name="completion_date" readonly="1" />
                        </group>
                        <group string="Additional Information">
                            <field name="teacher_id" readonly="1" />
                            <field name="priority" />
                            <field name="is_active" readonly="1" />
                            <field name="duration_days" readonly="1" />
                        </group>
                    </group>
                    <group string="Grade Information">
                        <field name="student_grade" readonly="1" />
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Enrollment Search View -->
    <record id="view_school_enrollment_search" model="ir.ui.view">
        <field name="name">school.enrollment.search</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <search string="Search Enrollments">
                <field name="student_id" />
                <field name="course_id" />
                <field name="teacher_id" />

                <separator />

                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]" />
                <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]" />
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]" />
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]" />
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]" />

                <separator />

                <filter name="filter_active" string="Active" domain="[('is_active', '=', True)]" />

                <separator />

                <group expand="0" string="Group By">
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}" />
                    <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}" />
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}" />
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Enrollment Action -->
    <record id="action_school_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_enrollment_search" />
        <field name="context">{'search_default_filter_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first enrollment!
            </p>
            <p>
                Enrollments link students to courses. Use the Bulk Enrollment wizard for multiple students.
            </p>
        </field>
    </record>
</odoo>