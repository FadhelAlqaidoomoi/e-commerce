<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    TEACHER VIEWS
    ================================================================== -->
    <!--
    TODO: Complete the Teacher Views
    
    Similar structure to Student views but with teacher-specific fields.
    -->

    <!-- Teacher List View -->
    <record id="view_school_teacher_list" model="ir.ui.view">
        <field name="name">school.teacher.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers" multi_edit="1" sample="1">
                <field name="employee_code" readonly="1" />
                <field name="name" />
                <field name="email" />
                <field name="phone" optional="hide" />
                <field name="department" optional="show" />
                <field name="hire_date" />
                <field name="qualification" optional="hide" />
                <field name="total_courses" optional="hide" readonly="1" />
                <field name="total_students" optional="hide" readonly="1" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- Teacher Form View -->
    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_courses"
                            type="object" icon="fa-graduation-cap">
                            <field string="Courses" name="total_courses" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" name="action_view_students"
                            type="object" icon="fa-users">
                            <field string="Students" name="total_students" widget="statinfo" />
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="employee_code" class="me-2" />
                            <field name="name" placeholder="Teacher Name" />
                        </h1>
                    </div>

                    <group>
                        <group string="Personal Information">
                            <field name="email" />
                            <field name="phone" />
                            <field name="date_of_birth" />
                        </group>
                        <group string="Employment Information">
                            <field name="hire_date" />
                            <field name="department" />
                            <field name="qualification" />
                        </group>
                        <group string="Compensation">
                            <field name="salary" />
                            <field name="currency_id" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Courses" name="courses">
                            <field name="course_ids">
                                <list string="Courses" editable="bottom">
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="credits" optional="hide" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                        <page string="Biography" name="biography">
                            <field name="biography" options="{'height': 300}" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Teacher Search View -->
    <record id="view_school_teacher_search" model="ir.ui.view">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search string="Search Teachers">
                <field name="employee_code" />
                <field name="name" />
                <field name="email" />

                <separator />

                <filter name="filter_inactive" string="Archived"
                    domain="[('active', '=', False)]" />

                <separator />

                <group expand="0" string="Group By">
                    <filter string="Department" name="group_by_department"
                        context="{'group_by': 'department'}" />
                    <filter string="Hire Date" name="group_by_hire_date"
                        context="{'group_by': 'hire_date'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Teacher Action -->
    <record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_teacher_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first teacher!
            </p>
        </field>
    </record>
</odoo>