<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    ENROLLMENT WIZARD VIEW
    ================================================================== -->
    
    <record id="view_school_enrollment_wizard_form" model="ir.ui.view">
        <field name="name">school.enrollment.wizard.form</field>
        <field name="model">school.enrollment.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Enrollment">
                <group>
                    <group>
                        <field name="course_id"/>
                        <!-- TODO: Add enrollment_date, skip_prerequisites -->
                    </group>
                    <group>
                        <!-- TODO: Add send_notification -->
                        <!-- TODO: Add available_seats (readonly), student_count (readonly) -->
                    </group>
                </group>
                
                <group string="Students">
                    <!-- TODO: Add student_ids Many2many with widget -->
                    <!-- Hint: widget="many2many_tags" or a list view -->
                </group>
                
                <group string="Notes">
                    <!-- TODO: Add notes field -->
                </group>
                
                <!-- TODO: Add warning_message field (readonly) -->
                
                <footer>
                    <button name="action_enroll" string="Enroll Students" 
                            type="object" class="btn-primary"/>
                    <button name="action_enroll_and_new" string="Enroll &amp; New" 
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_enrollment_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Enrollment</field>
        <field name="res_model">school.enrollment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    
    <!-- =================================================================
    BULK GRADE WIZARD VIEW
    ================================================================== -->
    
    <record id="view_school_bulk_grade_wizard_form" model="ir.ui.view">
        <field name="name">school.bulk.grade.wizard.form</field>
        <field name="model">school.bulk.grade.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Grade Entry">
                <group>
                    <group>
                        <field name="course_id"/>
                        <!-- TODO: Add grade_date, grade_type -->
                    </group>
                    <group>
                        <!-- TODO: Add max_score, description -->
                    </group>
                </group>
                
                <group string="Student Grades">
                    <!-- TODO: Add line_ids One2many -->
                    <!--
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="student_id"/>
                            <field name="score"/>
                            <field name="feedback"/>
                        </list>
                    </field>
                    -->
                </group>
                
                <footer>
                    <button name="action_load_students" string="Load Students" 
