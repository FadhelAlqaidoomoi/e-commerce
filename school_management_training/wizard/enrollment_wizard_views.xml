                </group>
                
                <group string="Student Attendance">
                    <!-- TODO: Add line_ids One2many -->
                </group>
                
                <footer>
                    <!-- TODO: Add action_mark_all_present, action_save buttons -->
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_bulk_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Attendance</field>
        <field name="res_model">school.bulk.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
