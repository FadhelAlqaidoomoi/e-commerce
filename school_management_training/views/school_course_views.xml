<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    COURSE VIEWS
    ================================================================== -->

    <!-- Course List View -->
    <record id="view_school_course_list" model="ir.ui.view">
        <field name="name">school.course.list</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list string="Courses" multi_edit="1" sample="1"
                decoration-info="state == 'draft'"
                decoration-success="state == 'in_progress'"
                decoration-muted="state in ('completed', 'cancelled')">
                <field name="code" />
                <field name="name" />
                <field name="teacher_id" />
                <field name="credits" optional="hide" />
                <field name="level" />
                <field name="enrolled_count" readonly="1" />
                <field name="available_seats" readonly="1" />
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                    decoration-success="state == 'in_progress'" decoration-muted="state in ('completed', 'cancelled')" />
            </list>
        </field>
    </record>

    <!-- Course Form View -->
    <record id="view_school_course_form" model="ir.ui.view">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <button name="action_plan" type="object" string="Plan"
                        invisible="state != 'draft'" class="btn-primary" />
                    <button name="action_start" type="object" string="Start"
                        invisible="state != 'planned'" class="btn-primary" />
                    <button name="action_complete" type="object" string="Complete"
                        invisible="state != 'in_progress'" class="btn-success" />
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state in ('completed', 'cancelled')" class="btn-danger" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,completed" readonly="1" />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_enrollments"
                            type="object" icon="fa-users">
                            <field string="Enrollments" name="enrolled_count" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" name="action_view_grades"
                            type="object" icon="fa-graduation-cap">
                            <field string="Grades" name="grade_count" widget="statinfo" />
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="code" class="me-2" />
                            <field name="name" placeholder="Course Name" />
                        </h1>
                    </div>

                    <group>
                        <group string="Course Details">
                            <field name="teacher_id" />
                            <field name="credits" />
                            <field name="hours_per_week" />
                            <field name="level" />
                            <field name="is_mandatory" widget="boolean_toggle" />
                            <field name="category_id" />
                        </group>
                        <group string="Capacity">
                            <field name="max_students" />
                            <field name="min_students" />
                            <field name="enrolled_count" readonly="1" />
                            <field name="available_seats" readonly="1" widget="progressbar" />
                        </group>
                    </group>

                    <group>
                        <group string="Schedule">
                            <field name="start_date" />
                            <field name="end_date" />
                        </group>
                        <group string="Course Information">
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" options="{'height': 300}" />
                        </page>
                        <page string="Prerequisites" name="prerequisites">
                            <field name="prerequisite_ids">
                                <list string="Prerequisites">
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="teacher_id" />
                                </list>
                            </field>
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids">
                                <list string="Enrollments" editable="bottom">
                                    <field name="student_id" />
                                    <field name="enrollment_date" />
                                    <field name="state" />
                                    <field name="student_grade" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page string="Grades" name="grades">
                            <field name="grade_ids">
                                <list string="Grades" editable="bottom">
                                    <field name="student_id" />
                                    <field name="date" />
                                    <field name="score" />
                                    <field name="percentage" readonly="1" />
                                    <field name="letter_grade" readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Course Search View -->
    <record id="view_school_course_search" model="ir.ui.view">
        <field name="name">school.course.search</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="code" />
                <field name="name" />
                <field name="teacher_id" />
                <field name="category_id" />

                <separator />

                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="filter_planned" string="Planned" domain="[('state', '=', 'planned')]" />
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]" />
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]" />
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]" />

                <separator />

                <filter name="filter_mandatory" string="Mandatory Only" domain="[('is_mandatory', '=', True)]" />
                <filter name="filter_full" string="Full Courses" domain="[('is_full', '=', True)]" />

                <separator />

                <group expand="0" string="Group By">
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}" />
                    <filter string="Level" name="group_by_level" context="{'group_by': 'level'}" />
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}" />
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Course Kanban View -->
    <record id="view_school_course_kanban" model="ir.ui.view">
        <field name="name">school.course.kanban</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" default_group_by="state">
                <field name="code" />
                <field name="name" />
                <field name="teacher_id" />
                <field name="state" />
                <field name="enrolled_count" />
                <field name="available_seats" />
                <field name="is_full" />
                <progressbar field="state"
                    colors='{"draft": "muted", "planned": "info", "in_progress": "success", "completed": "primary", "cancelled": "danger"}' />
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5">
                            <field name="code" class="me-2" />
                            <field name="name" />
                        </div>
                        <div class="text-muted small mt-2">
                            <field name="teacher_id" />
                        </div>
                        <div class="o_kanban_record_bottom mt-3">
                            <span class="badge bg-info" t-if="record.enrolled_count.raw_value">
                                <i class="fa fa-users me-1" />
                                <t t-esc="record.enrolled_count.raw_value" /> students </span>
                            <span class="badge bg-warning" t-if="record.is_full.raw_value">
                                Full
                            </span>
                            <span class="badge bg-success" t-else="">
                                <t t-esc="record.available_seats.raw_value" /> available </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Course Action -->
    <record id="action_school_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_school_course_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course!
            </p>
        </field>
    </record>


    <!-- =================================================================
    COURSE CATEGORY VIEWS
    ================================================================== -->

    <record id="view_school_course_category_list" model="ir.ui.view">
        <field name="name">school.course.category.list</field>
        <field name="model">school.course.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name" />
                <!-- TODO: Add complete_name, course_count -->
            </list>
        </field>
    </record>

    <record id="view_school_course_category_form" model="ir.ui.view">
        <field name="name">school.course.category.form</field>
        <field name="model">school.course.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name" />
                        <!-- TODO: Add parent_id -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_course_category" model="ir.actions.act_window">
        <field name="name">Course Categories</field>
        <field name="res_model">school.course.category</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- =================================================================
    COURSE TAG VIEWS
    ================================================================== -->

    <record id="view_school_course_tag_list" model="ir.ui.view">
        <field name="name">school.course.tag.list</field>
        <field name="model">school.course.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name" />
                <!-- TODO: Add color field with widget="color_picker" -->
            </list>
        </field>
    </record>

    <record id="action_school_course_tag" model="ir.actions.act_window">
        <field name="name">Course Tags</field>
        <field name="res_model">school.course.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>