<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    COURSE VIEWS
    ================================================================== -->
    
    <!-- Course List View -->
    <record id="view_school_course_list" model="ir.ui.view">
        <field name="name">school.course.list</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list string="Courses" multi_edit="1" sample="1"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'in_progress'"
                  decoration-muted="state in ('completed', 'cancelled')">
                <field name="code"/>
                <!-- TODO: Add name, teacher_id, credits, level -->
                <!-- TODO: Add enrolled_count, available_seats, state -->
            </list>
        </field>
    </record>
    
    <!-- Course Form View -->
    <record id="view_school_course_form" model="ir.ui.view">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <!-- TODO: Add state transition buttons -->
                    <!-- action_plan, action_start, action_complete, action_cancel -->
                    
                    <!-- TODO: Add state statusbar -->
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- TODO: Add stat buttons for enrollments, grades -->
                    </div>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="code" class="me-2"/>
                            <!-- TODO: Add name field -->
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Course Details">
                            <!-- TODO: Add teacher_id, credits, hours_per_week, level -->
                            <!-- TODO: Add is_mandatory, category_id, tag_ids -->
                        </group>
                        <group string="Capacity">
                            <!-- TODO: Add max_students, min_students -->
                            <!-- TODO: Add enrolled_count, available_seats (readonly) -->
                        </group>
                    </group>
                    
                    <group>
                        <group string="Schedule">
                            <!-- TODO: Add start_date, end_date -->
                        </group>
                        <group string="Prerequisites">
                            <!-- TODO: Add prerequisite_ids Many2many -->
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <!-- TODO: Add description Html field -->
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <!-- TODO: Add enrollment_ids One2many -->
                        </page>
                        <page string="Grades" name="grades">
                            <!-- TODO: Add grade_ids One2many -->
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Course Search View -->
    <record id="view_school_course_search" model="ir.ui.view">
        <field name="name">school.course.search</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="code"/>
                <!-- TODO: Add search fields and filters -->
            </search>
        </field>
    </record>
    
    <!-- Course Kanban View -->
    <record id="view_school_course_kanban" model="ir.ui.view">
        <field name="name">school.course.kanban</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" default_group_by="state">
                <field name="code"/>
                <!-- TODO: Add more fields -->
                <progressbar field="state" 
                             colors='{"draft": "muted", "planned": "info", "in_progress": "success", "completed": "primary", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <field class="fw-bold" name="code"/>
                        <!-- TODO: Complete kanban card -->
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Course Action -->
    <record id="action_school_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_school_course_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course!
            </p>
        </field>
    </record>
    
    
    <!-- =================================================================
    COURSE CATEGORY VIEWS
    ================================================================== -->
    
    <record id="view_school_course_category_list" model="ir.ui.view">
        <field name="name">school.course.category.list</field>
        <field name="model">school.course.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <!-- TODO: Add complete_name, course_count -->
            </list>
        </field>
    </record>
    
    <record id="view_school_course_category_form" model="ir.ui.view">
        <field name="name">school.course.category.form</field>
        <field name="model">school.course.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- TODO: Add parent_id -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_school_course_category" model="ir.actions.act_window">
        <field name="name">Course Categories</field>
        <field name="res_model">school.course.category</field>
        <field name="view_mode">list,form</field>
    </record>
    
    
    <!-- =================================================================
    COURSE TAG VIEWS
    ================================================================== -->
    
    <record id="view_school_course_tag_list" model="ir.ui.view">
        <field name="name">school.course.tag.list</field>
        <field name="model">school.course.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <!-- TODO: Add color field with widget="color_picker" -->
            </list>
        </field>
    </record>
    
    <record id="action_school_course_tag" model="ir.actions.act_window">
        <field name="name">Course Tags</field>
        <field name="res_model">school.course.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
