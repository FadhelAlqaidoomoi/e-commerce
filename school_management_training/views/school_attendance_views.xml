<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    ATTENDANCE VIEWS
    ================================================================== -->

    <!-- Attendance List View -->
    <record id="view_school_attendance_list" model="ir.ui.view">
        <field name="name">school.attendance.list</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" multi_edit="1" sample="1"
                decoration-success="status == 'present'"
                decoration-warning="status == 'late'"
                decoration-danger="status == 'absent'"
                decoration-info="status == 'excused'">
                <field name="date" />
                <field name="student_id" />
                <field name="course_id" />
                <field name="status" widget="badge" decoration-success="status == 'present'"
                    decoration-warning="status == 'late'" decoration-danger="status == 'absent'" />
                <field name="check_in" optional="hide" />
                <field name="check_out" optional="hide" />
                <field name="duration_hours" readonly="1" optional="hide" />
                <field name="is_excused" widget="boolean" optional="hide" />
                <field name="remarks" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_school_attendance_form" model="ir.ui.view">
        <field name="name">school.attendance.form</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <group>
                        <group string="Attendance Details">
                            <field name="date" />
                            <field name="student_id" />
                            <field name="course_id" />
                            <field name="status" widget="selection" />
                            <field name="day_of_week" readonly="1" />
                        </group>
                        <group string="Time Tracking">
                            <field name="check_in" />
                            <field name="check_out" />
                            <field name="duration_hours" readonly="1" />
                            <field name="is_on_time" readonly="1" widget="boolean" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="is_excused" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field name="recorded_by" readonly="1" />
                        </group>
                    </group>
                    <group string="Remarks">
                        <field name="remarks" nolabel="1" options="{'height': 100}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Search View -->
    <record id="view_school_attendance_search" model="ir.ui.view">
        <field name="name">school.attendance.search</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="date" />
                <field name="student_id" />
                <field name="course_id" />
                <field name="recorded_by" />

                <!-- Filters -->
                <filter name="filter_today" string="Today"
                    domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]" />
                <filter name="filter_present" string="Present" domain="[('status', '=', 'present')]" />
                <filter name="filter_absent" string="Absent" domain="[('status', '=', 'absent')]" />
                <filter name="filter_late" string="Late" domain="[('status', '=', 'late')]" />
                <filter name="filter_excused" string="Excused" domain="[('is_excused', '=', True)]" />

                <separator />

                <group expand="0" string="Group By">
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}" />
                    <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}" />
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}" />
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}" />
                    <filter string="Day of Week" name="group_by_day" context="{'group_by': 'day_of_week'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Attendance Calendar View -->
    <record id="view_school_attendance_calendar" model="ir.ui.view">
        <field name="name">school.attendance.calendar</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <calendar string="Attendance" date_start="date" color="status" mode="month">
                <field name="student_id" />
                <field name="course_id" />
                <field name="status" />
            </calendar>
        </field>
    </record>

    <!-- Attendance Action -->
    <record id="action_school_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_school_attendance_search" />
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record attendance for today!
            </p>
            <p>
                Use the Bulk Attendance wizard to mark attendance for all students in a course.
            </p>
        </field>
    </record>
</odoo>